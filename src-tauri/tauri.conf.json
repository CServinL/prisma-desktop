{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "prisma-desktop",
  "version": "0.2.0",
  "identifier": "dev.cservinl.prisma-desktop",
  "build": {
    "devUrl": "http://127.0.0.1:8766/app",
    "frontendDist": "http://127.0.0.1:8766/app"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Prisma",
        "url": "about:blank",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 500,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost http: https: ws: wss:; img-src 'self' data: http: https:; frame-src http: https:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
