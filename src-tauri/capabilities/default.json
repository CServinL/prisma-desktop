{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "remote": {
    "urls": ["http://*:*/**", "https://*:*/**"]
  },
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "allow-app-commands"
  ]
}
